# Copy this file to .env and fill in your own Twilio credentials.
# Get these from https://console.twilio.com after creating a free Twilio account.

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# WhatsApp: use Twilio's sandbox number "whatsapp:+14155238886" for testing,
# or your own approved WhatsApp sender once you have one.
# SMS: use a Twilio phone number you purchased, e.g. "+1XXXXXXXXXX".
REMINDER_CHANNEL=whatsapp
TWILIO_FROM=whatsapp:+14155238886

# Country code prepended to customer numbers that don't already start with "+"
DEFAULT_COUNTRY_CODE=+91

PORT=4000
