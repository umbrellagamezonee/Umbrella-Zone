# Copy this file to .env.local and fill in your Supabase project's values
# (Supabase dashboard -> Settings -> API). Both are safe to embed in
# frontend code — the anon key is meant for exactly this, never paste the
# "service_role" key here.
#
# Leave both blank / delete this file's copy to run fully local (no cloud
# sync) — that's the default and always works.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
